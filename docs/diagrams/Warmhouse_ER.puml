@startuml Warmhouse_ER
!define table(x) class x as "x" << (T,#FFAAAA) >>
!define primary_key(x) <u>x</u>

table(User) {
  primary_key(id): UUID
  email: string
  name: string
  created_at: datetime
}

table(UserSettings) {
  primary_key(id): UUID
  user_id: UUID
  notifications_enabled: boolean
}

User ||--|| UserSettings : "has"

table(House) {
  primary_key(id): UUID
  user_id: UUID
  address: string
}

table(Device) {
  primary_key(id): UUID
  type_id: UUID
  house_id: UUID
  status: string
}

table(DeviceType) {
  primary_key(id): UUID
  type: string
}

User ||--o{ House : "owns >"
House ||--o{ Device : "contains >"
Device }o--|| DeviceType : "is >"

table(TelemetrySensor) {
  primary_key(id): UUID
  device_id: UUID
  type: string
}

table(TelemetryData) {
  primary_key(id): UUID
  sensor_id: UUID
  value: float
  timestamp: datetime
}

Device ||--o{ TelemetrySensor : "has >"
TelemetrySensor ||--o{ TelemetryData : "produces >"

table(HeatingState) {
  primary_key(id): UUID
  house_id: UUID
  status: string
  timestamp: datetime
}

table(HeatingPlan) {
  primary_key(id): UUID
  house_id: UUID
  temperature: float
  start_time: time
  end_time: time
  enabled: boolean
}

House ||--o{ HeatingState : "has history >"
House ||--o{ HeatingPlan : "uses >"

@enduml