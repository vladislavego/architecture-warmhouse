@startuml TelemetryService_Component
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Container(telemetryService, "Telemetry Service", "Django")

Component(api, "TelemetryGrpcEndpoint", "gRPC Endpoint", "Предоставляет телеметрию по запросу")
Component(collector, "TelemetryCollector", "Service", "Получает телеметрию от устройств")
Component(repo, "TelemetryRepository", "Repository", "Работа с данными телеметрии")
Component(eventPublisher, "TelemetryEventProducer", "Kafka Producer", "Публикует события об изменениях")
ContainerDb(telemetryDb, "Telemetry DB", "PostgreSQL", "Хранение телеметрии и сенсоров")

Rel(api, repo, "Читает данные")
Rel(collector, repo, "Сохраняет телеметрию")
Rel(collector, eventPublisher, "Публикует в Kafka")
Rel(repo, telemetryDb, "Читает/пишет", "JDBC")

@enduml